# Archivos YAML de Unity: texto con finales de línea LF
*.unity       text eol=lf
*.prefab      text eol=lf
*.mat         text eol=lf
*.asset       text eol=lf
*.controller  text eol=lf
*.anim        text eol=lf
*.meta        text eol=lf
*.cs          text eol=lf diff=csharp

# Binarios: nunca intentar hacer merge ni diff de texto
*.fbx         binary
*.FBX         binary
*.png         binary
*.PNG         binary
*.jpg         binary
*.psd         binary
*.wav         binary
*.mp3         binary
*.ogg         binary
*.unitypackage binary
*.so          binary
*.x86_64      binary
*.resS        binary
